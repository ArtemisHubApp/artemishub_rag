# Optional: OpenAI-compatible chat API; without these, query prints evidence only.
# Never commit .env; it is listed in .gitignore.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=

# Gemini (free key at https://aistudio.google.com/apikey), through its OpenAI-compatible endpoint:
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-3.5-flash

# Embeddings run locally and need no key. These are already the defaults in src/common.py;
# change them only together with a full reindex.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_REVISION=e8f8c211226b894fcb81acc59f3b34ba3efd5f42
